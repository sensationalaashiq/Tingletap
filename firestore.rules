rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // ROLE AND PERMISSION HELPERS
    // Normalizes role names and casing:
    // owner / superowner / Godfather
    // admin / High Council
    // moderator / mod / Guardian
    // rj / RJ
    // user / member
    // guest
    // ================================================================

    function getRole(uid) {
      let r = exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user')
        : 'user';
      return r in ['superowner', 'owner', 'Owner', 'SuperOwner', 'Godfather'] ? 'owner'
           : r in ['admin', 'Admin', 'High Council'] ? 'admin'
           : r in ['moderator', 'Moderator', 'mod', 'Mod', 'Guardian'] ? 'moderator'
           : r in ['rj', 'RJ'] ? 'rj'
           : r in ['guest', 'Guest'] ? 'guest'
           : 'user';
    }

    function myRole() {
      return request.auth != null ? getRole(request.auth.uid) : 'guest';
    }

    function isOwner()      { return request.auth != null && myRole() == 'owner'; }
    function isAdmin()      { return request.auth != null && (myRole() == 'admin' || isOwner()); }
    function isModerator()  { return request.auth != null && (myRole() == 'moderator' || isAdmin()); }
    function isStaff()      { return request.auth != null && (myRole() in ['owner', 'admin', 'moderator']); }
    function isRJ()         { return request.auth != null && (myRole() == 'rj' || isStaff()); }
    function isGuest()      { return request.auth != null && myRole() == 'guest'; }
    function isRegistered() { return request.auth != null && myRole() != 'guest'; }

    // Hierarchy safeguard: lower staff cannot modify higher staff
    function canStaffModifyTarget(targetUid) {
      let tRole = getRole(targetUid);
      return isOwner()
          || (isAdmin()     && tRole != 'owner')
          || (isModerator() && tRole != 'owner' && tRole != 'admin');
    }

    // ================================================================
    // MODERATION STATUS CHECKS (Ban / Mute / Kick)
    // ================================================================

    function isBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.get('isBanned', false) == true;
    }

    function isMuted(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data
               .get('mutedInfo', {}).get('isMuted', false) == true;
    }

    function isKickedFrom(uid, roomId) {
      let kickPath = /databases/$(database)/documents/rooms/$(roomId)/kickedUsers/$(uid);
      let kickExists = exists(kickPath);
      let expiry = kickExists ? get(kickPath).data.get('kickUntilTs', null) : null;
      return kickExists && (expiry == null || request.time < expiry);
    }

    function notBanned() { return !isBanned(request.auth.uid); }
    function notMuted()  { return !isMuted(request.auth.uid); }

    function isTingleBot() {
      return request.auth != null && request.auth.uid == 'tinglebot_system_official_2024';
    }

    function isBlocked(blockerId, blockedId) {
      return exists(/databases/$(database)/documents/users/$(blockerId)) &&
             get(/databases/$(database)/documents/users/$(blockerId)).data
               .get('blockedUsers', []).hasAny([blockedId]);
    }

    // ================================================================
    // USERNAMES COLLECTION
    // ================================================================
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null
                    && (request.auth.uid == resource.data.uid || isStaff());
    }

    // ================================================================
    // USERS COLLECTION
    // ================================================================
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && (isStaff() || request.resource.data.get('role', 'user') in ['user', 'guest'])
                    && (isStaff() || !request.resource.data.keys().hasAny(['isBanned', 'bannedBy', 'bannedAt']));

      // User updating own profile
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      isStaff() || (
                        !isBanned(request.auth.uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['role', 'isBanned', 'bannedBy', 'bannedAt', 'mutedInfo'])
                        && !(request.resource.data.get('badge', null) in ['the_olympian', 'titans', 'spartans'])
                      )
                    );

      // Staff updating target user
      allow update: if isStaff()
                    && exists(/databases/$(database)/documents/users/$(userId))
                    && canStaffModifyTarget(userId);

      allow delete: if isOwner();
    }

    // ================================================================
    // PUBLIC PROFILES COLLECTION
    // ================================================================
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && (request.auth.uid == userId || isStaff());
      allow delete: if isOwner();
    }

    // ================================================================
    // FRIEND REQUESTS
    // ================================================================
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.senderId == request.auth.uid
                      || resource.data.receiverId == request.auth.uid
                      || isStaff());

      allow create: if request.auth != null
                    && notBanned()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.senderId != request.resource.data.receiverId;

      allow update: if request.auth != null
                    && (resource.data.senderId == request.auth.uid
                        || resource.data.receiverId == request.auth.uid
                        || isStaff());

      allow delete: if request.auth != null
                    && (resource.data.senderId == request.auth.uid
                        || resource.data.receiverId == request.auth.uid
                        || isStaff());
    }

    // ================================================================
    // ROOMS AND CHAT MESSAGES
    // ================================================================
    match /rooms/{roomId} {
      allow read:   if true;
      allow create, update: if isStaff();
      allow delete: if isOwner() || isAdmin();

      match /messages/{messageId} {
        allow read: if true;

        allow create: if request.auth != null && (
          isStaff() ||
          isTingleBot() ||
          (
            notBanned() &&
            notMuted() &&
            !isKickedFrom(request.auth.uid, roomId) &&
            (request.resource.data.get('isBot', false) != true || request.resource.data.get('tinglebotType', '') in ['join', 'leave'])
          )
        );

        allow update: if isStaff()
                      || (request.auth != null && resource.data.uid == request.auth.uid && notBanned());

        allow delete: if isStaff()
                      || (request.auth != null && resource.data.uid == request.auth.uid);
      }

      match /kickedUsers/{kickedUserId} {
        allow read:  if request.auth != null;
        allow create, update: if isStaff();
        allow delete: if isStaff() || (request.auth != null && request.auth.uid == kickedUserId);
      }

      match /automod/{document=**} {
        allow read, write: if isStaff();
      }
    }

    // ================================================================
    // PRIVATE MESSAGES
    // ================================================================
    match /privateMessages/{messageId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && (request.auth.uid in resource.data.get('participants', [])
                          || resource.data.get('receiverId', '') == request.auth.uid
                          || resource.data.get('senderId', '') == request.auth.uid)
                      && notBanned());

      allow create: if request.auth != null && (
        isStaff() ||
        (
          notBanned() && notMuted()
          && (
            request.auth.uid in request.resource.data.get('participants', [])
            || request.resource.data.senderId == request.auth.uid
          )
          && !isBlocked(request.resource.data.get('receiverId', '_'), request.auth.uid)
        )
      );

      allow update: if isStaff()
                    || (request.auth != null
                        && (request.auth.uid in resource.data.get('participants', [])
                            || resource.data.get('receiverId', '') == request.auth.uid
                            || resource.data.get('senderId', '') == request.auth.uid)
                        && notBanned());

      allow delete: if isStaff()
                    || (request.auth != null
                        && (request.auth.uid in resource.data.get('participants', [])
                            || resource.data.get('receiverId', '') == request.auth.uid
                            || resource.data.get('senderId', '') == request.auth.uid));
    }

    // ================================================================
    // WHISPERS
    // ================================================================
    match /whispers/{whisperId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && (resource.data.get('senderId', '') == request.auth.uid
                          || resource.data.get('receiverId', '') == request.auth.uid));

      allow create: if request.auth != null
                    && notBanned()
                    && notMuted()
                    && request.resource.data.senderId == request.auth.uid
                    && !isBlocked(request.resource.data.get('receiverId', '_'), request.auth.uid);

      allow update, delete: if isStaff()
                    || (request.auth != null
                        && (resource.data.get('senderId', '') == request.auth.uid
                            || resource.data.get('receiverId', '') == request.auth.uid));
    }

    // ================================================================
    // CALLS (Voice and Video)
    // ================================================================
    match /calls/{callId} {
      allow read: if request.auth != null
                  && (isStaff()
                      || request.auth.uid == resource.data.get('callerId', '')
                      || request.auth.uid == resource.data.get('recipientId', ''));

      allow create: if request.auth != null
                    && request.resource.data.callerId == request.auth.uid
                    && notBanned();

      allow update, delete: if request.auth != null
                            && (isStaff()
                                || request.auth.uid == resource.data.get('callerId', '')
                                || request.auth.uid == resource.data.get('recipientId', ''));

      match /offerCandidates/{docId} {
        allow read, write: if request.auth != null && notBanned();
      }

      match /answerCandidates/{docId} {
        allow read, write: if request.auth != null && notBanned();
      }
    }

    // ================================================================
    // CONVERSATIONS
    // ================================================================
    match /conversations/{conversationId} {
      allow read: if isStaff()
                  || (request.auth != null
                      && request.auth.uid in resource.data.get('participants', [])
                      && notBanned());

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.get('participants', [])
                    && notBanned();

      allow update: if isStaff()
                    || (request.auth != null
                        && request.auth.uid in resource.data.get('participants', [])
                        && notBanned());

      allow delete: if isStaff()
                    || (request.auth != null
                        && request.auth.uid in resource.data.get('participants', []));

      match /messages/{messageId} {
        allow read, write: if request.auth != null && notBanned();
      }
    }

    // ================================================================
    // REPORTS AND FEEDBACK
    // ================================================================
    match /reports/{reportId} {
      allow create: if request.auth != null && notBanned();
      allow read: if request.auth != null && (resource.data.reportedBy.uid == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null && notBanned();
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    // ================================================================
    // NOTIFICATIONS
    // ================================================================
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && (resource.data.get('userId', '') == request.auth.uid || isStaff());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                  && (resource.data.get('userId', '') == request.auth.uid || isStaff() || isTingleBot());
    }

    // ================================================================
    // BLOCKS
    // ================================================================
    match /blocks/{blockId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        request.resource.data.get('blockerId', '') == request.auth.uid
        || resource.data.get('blockerId', '') == request.auth.uid
        || isStaff()
      );
    }

    // ================================================================
    // PRESENCE AND STYLES
    // ================================================================
    match /presence/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == userId || isStaff());
    }

    match /globalUsernameStyles/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == userId || isStaff());
    }

    match /globalMessageStyles/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (request.auth.uid == userId || isStaff());
    }

    // ================================================================
    // UPLOADS
    // ================================================================
    match /uploads/{uploadId} {
      allow read: if true;
      allow create: if request.auth != null && notBanned();
      allow update, delete: if request.auth != null
                    && (resource.data.uploadedBy == request.auth.uid || isStaff());
    }

    // ================================================================
    // RADIO STATIONS, GAMES, LEADERBOARDS, ACHIEVEMENTS
    // ================================================================
    match /radioStations/{stationId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isStaff();

      match /participants/{participantId} {
        allow read, write: if request.auth != null;
      }
    }

    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ================================================================
    // WARNINGS AND ANNOUNCEMENTS
    // ================================================================
    match /warnings_announcements/{document=**} {
      allow read:  if true;
      allow write: if isStaff() || isTingleBot();
    }

    // ================================================================
    // SYSTEM AND MODERATION LOGS
    // ================================================================
    match /modLogs/{document=**} {
      allow read:  if isStaff();
      allow write: if request.auth != null;
    }

    match /moderationLogs/{document=**} {
      allow read:  if isStaff();
      allow write: if request.auth != null;
    }

    match /systemLogs/{document=**} {
      allow read:  if isStaff();
      allow write: if request.auth != null;
    }

    // ================================================================
    // BAN INFRASTRUCTURE (IPs and Devices)
    // ================================================================
    match /bannedIPs/{document=**} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /bannedDevices/{document=**} {
      allow read:  if true;
      allow write: if isStaff();
    }

    // ================================================================
    // ADMIN AND SETTINGS
    // ================================================================
    match /settings/{document=**} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /admin/{document=**} {
      allow read, write: if isStaff();
    }

    match /guestSessions/{sessionId} {
      allow read:          if isStaff() || (request.auth != null && request.auth.uid == sessionId);
      allow create, update: if request.auth != null && request.auth.uid == sessionId;
      allow delete:        if isStaff();
    }

    match /statistics/{document=**} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }

    match /bannedWords/{document=**} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /analytics/{document=**} {
      allow read, write: if isStaff();
    }

    // ================================================================
    // BADGES, EMOJIS, STICKERS, THEMES
    // ================================================================
    match /badges/{document=**} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /emojis/{emojiId} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /stickers/{stickerId} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /themes/{themeId} {
      allow read:  if true;
      allow write: if isStaff();
    }

    match /userPreferences/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      allow write: if request.auth != null && (request.auth.uid == userId || isStaff());
    }

    // ================================================================
    // PUBLIC BROADCASTS
    // ================================================================
    match /publicBroadcasts/{docId} {
      allow read: if true;
      allow create: if request.auth != null && isRegistered()
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        isStaff() || (resource.data.hostUid == request.auth.uid)
      );
    }

    // ================================================================
    // COIN WALLET AND ANTI-CHEAT GIFT SYSTEM
    // ================================================================
    match /settings/coinConfig {
      allow read: if true;
      allow write: if isStaff();
    }

    match /coinWallets/{uid} {
      allow read: if request.auth != null;

      // Bootstrap own wallet with zero balance
      allow create: if request.auth != null && notBanned()
                    && (isStaff() || (
                      request.auth.uid == uid
                      && request.resource.data.balance == 0
                      && request.resource.data.get('totalPurchased', 0) == 0
                    ));

      // Wallet update: staff bypass OR secure gifting rules
      allow update: if request.auth != null && notBanned() && (
        isStaff() ||
        // Own wallet: deducting coins for gifts (balance can only decrease or stay equal)
        (
          request.auth.uid == uid
          && request.resource.data.balance <= resource.data.balance
          && request.resource.data.balance >= 0
        ) ||
        // Other user's wallet: crediting gift coins (balance can only increase)
        (
          request.auth.uid != uid
          && request.resource.data.balance >= resource.data.balance
          && request.resource.data.get('lastGiftFromUid', '') == request.auth.uid
        )
      );
    }

    match /coinTransactions/{txId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && notBanned() && (
        isStaff() ||
        (
          (request.resource.data.type == 'gift_sent' && request.resource.data.uid == request.auth.uid && request.resource.data.coins < 0) ||
          (request.resource.data.type == 'gift_received' && request.resource.data.get('fromUid', '') == request.auth.uid && request.resource.data.coins > 0)
        )
      );
      allow update, delete: if isStaff();
    }

    match /giftRecords/{recordId} {
      allow read: if true;
      allow create: if request.auth != null && notBanned() && (
        isStaff() || request.resource.data.fromUid == request.auth.uid
      );
      allow update, delete: if isStaff();
    }

    // Payment orders: users submit with 'pending', staff verifies and approves
    match /paymentOrders/{orderId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isStaff()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'submitted');
      allow delete: if isStaff();
    }

    // ================================================================
    // RJ SYSTEM AND EARNINGS
    // ================================================================
    match /rjEarnings/{rjUid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && notBanned() && (
        isStaff() || (
          request.resource.data.get('lastGiftFromUid', '') == request.auth.uid
          && (!exists(/databases/$(database)/documents/rjEarnings/$(rjUid)) || request.resource.data.totalCoins >= resource.data.totalCoins)
        )
      );
      allow delete: if isStaff();
    }

    match /rjWithdrawalInfo/{rjUid} {
      allow read: if request.auth != null && (request.auth.uid == rjUid || isStaff());
      allow write: if request.auth != null && (request.auth.uid == rjUid || isStaff());
    }

    match /rjPayments/{paymentId} {
      allow read: if request.auth != null && (resource.data.rjUid == request.auth.uid || isStaff());
      allow write: if isStaff();
    }

    match /users/{rjUid}/followers/{followerUid} {
      allow read: if true;
      allow create, delete: if request.auth != null && (request.auth.uid == followerUid || isStaff());
      allow write: if isStaff();
    }

    match /users/{uid}/following/{rjUid} {
      allow read: if true;
      allow create, delete: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if isStaff();
    }

    // ================================================================
    // OWNER EMAIL CENTER
    // ================================================================
    match /emailHistory/{docId} {
      allow read, write: if isStaff();
    }

    match /ownerEmails/{emailId} {
      allow read, write: if isStaff();
    }

    // ================================================================
    // VERIFICATION APPLICATIONS (Badges and RJ)
    // ================================================================
    match /badgeApplications/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null
                    && (request.auth.uid == uid || isStaff())
                    && (isStaff() || request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isStaff()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'badgeAwarded']));
      allow delete: if isStaff();
    }

    match /rjApplications/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null
                    && (request.auth.uid == uid || isStaff())
                    && (isStaff() || request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isStaff()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'approved']));
      allow delete: if isStaff();
    }

    // ================================================================
    // SERVER-ONLY COLLECTIONS AND LEADERBOARD SNAPSHOTS
    // ================================================================
    match /_rateLimits/{doc} {
      allow read, write: if false;
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ================================================================
    // CATCH-ALL FALLBACK
    // ================================================================
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

  }
}
