{
  "project": "Tingletap",
  "description": "Firebase Firestore and Realtime Database data architecture for Tingletap real-time social chat, Message Requests, Theatre synchronized cinema, Group DMs, Room Invites, and Chat Privacy Controls.",
  "entities": {
    "UserProfile": {
      "collection": "users/{uid}",
      "description": "Authoritative user profile, role, verified badge, moderation state, friends, blockedUsers, and privacy settings.",
      "fields": {
        "uid": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": true },
        "username": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "role": { "type": "string", "enum": ["owner", "admin", "moderator", "rj", "user", "guest"] },
        "badge": { "type": "string", "nullable": true },
        "isGuest": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "friends": { "type": "array" },
        "blockedUsers": { "type": "array" },
        "settings": {
          "type": "map",
          "description": "Includes allowPrivateMessagesLevel (all|friends|none), whoCanGroupDm (all|friends|none), whoCanInviteRooms (all|friends|none), readReceipts (bool), typingIndicator (bool), onlineStatusLevel (all|friends|none), lastSeenLevel (all|friends|none), showOnlineStatus (bool), showLastSeen (bool), showInSearch (bool)."
        }
      }
    },
    "MessageRequest": {
      "collection": "messageRequests/{requestId}",
      "description": "Pending, accepted, or silently declined direct-message request from non-connected users when recipient requires message requests.",
      "fields": {
        "id": { "type": "string" },
        "conversationId": { "type": "string", "required": true },
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string" },
        "senderUsername": { "type": "string" },
        "senderPhoto": { "type": "string", "nullable": true },
        "senderGender": { "type": "string" },
        "senderRole": { "type": "string" },
        "senderBadge": { "type": "string", "nullable": true },
        "senderIsVerified": { "type": "boolean" },
        "senderFriends": { "type": "array" },
        "receiverId": { "type": "string", "required": true },
        "receiverName": { "type": "string" },
        "participants": { "type": "array", "required": true },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"], "required": true },
        "lastMessagePreview": { "type": "string" },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp" },
        "acceptedAt": { "type": "timestamp", "nullable": true },
        "declinedAt": { "type": "timestamp", "nullable": true }
      }
    },
    "GroupDM": {
      "collection": "groupDms/{groupId}",
      "description": "Private Group Direct Message conversation with role-based administration (owner, admin, member).",
      "fields": {
        "name": { "type": "string", "maxLength": 60, "required": true },
        "photoURL": { "type": "string", "nullable": true },
        "photoKey": { "type": "string", "nullable": true },
        "createdBy": { "type": "string", "required": true },
        "ownerUid": { "type": "string", "required": true },
        "memberUids": { "type": "array", "maxItems": 50, "required": true },
        "memberRoles": { "type": "map", "description": "Map of uid -> owner | admin | member" },
        "invitePolicy": { "type": "string", "enum": ["admins_only", "all_members"] },
        "pinnedMessage": { "type": "map", "nullable": true },
        "typing": { "type": "map" },
        "unreadBy": { "type": "map" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderName": { "type": "string" },
        "lastMessageAt": { "type": "timestamp" },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "GroupDMMessage": {
      "collection": "groupDms/{groupId}/messages/{messageId}",
      "description": "Messages inside a private Group DM.",
      "fields": {
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string", "nullable": true },
        "senderGender": { "type": "string" },
        "senderRole": { "type": "string" },
        "senderBadge": { "type": "string", "nullable": true },
        "text": { "type": "string" },
        "imageUrl": { "type": "string", "nullable": true },
        "imageKey": { "type": "string", "nullable": true },
        "audioUrl": { "type": "string", "nullable": true },
        "audioKey": { "type": "string", "nullable": true },
        "audioFileName": { "type": "string", "nullable": true },
        "fileUrl": { "type": "string", "nullable": true },
        "fileName": { "type": "string", "nullable": true },
        "replyTo": { "type": "map", "nullable": true },
        "mentions": { "type": "array" },
        "deletedFor": { "type": "array" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "RoomInvite": {
      "collection": "roomInvites/{inviteId}",
      "description": "Direct invitation to join a Tingletap chat room honoring whoCanInviteRooms privacy settings.",
      "fields": {
        "roomId": { "type": "string", "required": true },
        "roomName": { "type": "string", "required": true },
        "roomSlug": { "type": "string", "required": true },
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string", "nullable": true },
        "receiverId": { "type": "string", "required": true },
        "status": { "type": "string", "enum": ["pending", "accepted", "dismissed"] },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "TheatreSession": {
      "collection": "rooms/{roomId}/theatre/{sessionId}",
      "canonicalDocId": "current",
      "description": "Synchronized watch-party state for the existing Theatre room.",
      "fields": {
        "videoUrl": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["youtube", "mp4"] },
        "videoId": { "type": "string", "nullable": true },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["idle", "active"] },
        "isPlaying": { "type": "boolean", "required": true },
        "anchorTimeSec": { "type": "number", "required": true },
        "anchorMs": { "type": "number", "required": true },
        "playbackRate": { "type": "number" },
        "hostUid": { "type": "string", "required": true },
        "hostName": { "type": "string" },
        "coHostUids": { "type": "array", "maxItems": 10 },
        "updatedBy": { "type": "string", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "RoomMood": {
      "collection": "rooms/{roomId}/mood/{moodDocId}",
      "canonicalDocId": "current",
      "description": "Live atmosphere and mood state synced across all room members.",
      "fields": {
        "preset": {
          "type": "string",
          "enum": ["midnight-velvet", "navrang-aura", "neon-lounge", "warm-mehfil"],
          "required": true
        },
        "locked": { "type": "boolean", "required": true },
        "updatedBy": { "type": "string", "required": true },
        "updatedByName": { "type": "string" },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "RoomActivity": {
      "collection": "rooms/{roomId}/activities/{activityId}",
      "description": "Inline interactive mini-game or poll card in chat (poll, trivia, wheel, atlas, word).",
      "fields": {
        "id": { "type": "string" },
        "roomId": { "type": "string", "required": true },
        "type": { "type": "string", "enum": ["poll", "trivia", "wheel", "atlas", "word"], "required": true },
        "title": { "type": "string", "maxLength": 140, "required": true },
        "creatorUid": { "type": "string", "required": true },
        "status": { "type": "string", "enum": ["active", "ended", "spinning"] },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "SilentWatchSession": {
      "collection": "rooms/{roomId}/silentWatch/{uid}",
      "description": "Strict staff-only stealth state preventing non-staff reads or spoofing.",
      "fields": {
        "uid": { "type": "string", "required": true },
        "active": { "type": "boolean", "required": true },
        "roomId": { "type": "string", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "DailySchedule": {
      "collection": "schedules/{scheduleId}",
      "canonicalDocId": "dailyLineup",
      "description": "Single lightweight document storing today's scheduled broadcasts and RJ hosts.",
      "fields": {
        "shows": { "type": "array", "maxItems": 40 },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      }
    }
  }
}
